<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>سوق الجزائر</title>

  <style>
    * {
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      margin: 0;
      background: #f5f7f6;
      color: #222;
    }

    header {
      background: #16834a;
      color: white;
      padding: 22px 18px;
      border-radius: 0 0 25px 25px;
    }

    header h1 {
      margin: 0 0 8px;
      font-size: 28px;
    }

    header p {
      margin: 0;
      opacity: .9;
    }

    .container {
      padding: 18px;
      max-width: 700px;
      margin: auto;
    }

    .search {
      width: 100%;
      padding: 15px;
      border: none;
      border-radius: 14px;
      margin: 15px 0;
      font-size: 16px;
      box-shadow: 0 2px 8px #ddd;
    }

    select {
      width: 100%;
      padding: 14px;
      border-radius: 12px;
      border: 1px solid #ddd;
      background: white;
      font-size: 16px;
    }

    h2 {
      margin-top: 25px;
    }

    .cards {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .card {
      background: white;
      padding: 16px;
      border-radius: 18px;
      box-shadow: 0 2px 8px #ddd;
    }

    .icon {
      font-size: 35px;
    }

    .name {
      font-weight: bold;
      margin-top: 8px;
    }

    .price {
      color: #16834a;
      font-size: 20px;
      font-weight: bold;
      margin-top: 8px;
    }

    .unit {
      font-size: 13px;
      color: #777;
    }

    .update {
      margin-top: 8px;
      font-size: 12px;
      color: #888;
    }

    nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: white;
      display: flex;
      justify-content: space-around;
      padding: 12px 5px;
      box-shadow: 0 -2px 10px #ddd;
    }

    nav button {
      border: none;
      background: none;
      font-size: 13px;
      color: #555;
    }

    nav .active {
      color: #16834a;
      font-weight: bold;
    }

    .space {
      height: 75px;
    }
  </style>
</head>

<body>

  <header>
    <h1>🇩🇿 سوق الجزائر</h1>
    <p>أسعار الخضر والفواكه في مختلف ولايات الجزائر</p>
  </header>

  <div class="container">

    <input
      class="search"
      type="search"
      placeholder="🔎 ابحث عن خضرة أو فاكهة..."
    >

    <select>
      <option>اختر الولاية</option>
      <option>سطيف</option>
      <option>الجزائر</option>
      <option>وهران</option>
      <option>قسنطينة</option>
      <option>باتنة</option>
      <option>بسكرة</option>
      <option>عنابة</option>
      <option>بجاية</option>
      <option>البليدة</option>
      <option>تيزي وزو</option>
      <option>أدرار</option>
    </select>

    <h2>أسعار اليوم 🥬</h2>

    <div class="cards">

      <div class="card">
        <div class="icon">🍅</div>
        <div class="name">الطماطم</div>
        <div class="price">120 دج</div>
        <div class="unit">للكيلوغرام</div>
        <div class="update">آخر تحديث: اليوم</div>
      </div>

      <div class="card">
        <div class="icon">🥒</div>
        <div class="name">الخيار</div>
        <div class="price">100 دج</div>
        <div class="unit">للكيلوغرام</div>
        <div class="update">آخر تحديث: اليوم</div>
      </div>

      <div class="card">
        <div class="icon">🥔</div>
        <div class="name">البطاطا</div>
        <div class="price">90 دج</div>
        <div class="unit">للكيلوغرام</div>
        <div class="update">آخر تحديث: اليوم</div>
      </div>

      <div class="card">
        <div class="icon">🫑</div>
        <div class="name">الفلفل</div>
        <div class="price">150 دج</div>
        <div class="unit">للكيلوغرام</div>
        <div class="update">آخر تحديث: اليوم</div>
      </div>

    </div>

    <div class="space"></div>
  </div>

  <nav>
    <button class="active">🏠<br>الرئيسية</button>
    <button>📊<br>الأسعار</button>
    <button>📍<br>الولايات</button>
    <button>👤<br>حسابي</button>
  </nav>

</body>
</html>
